{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "smarteg-web",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "bucket_name": "smarteg-web-inc-cache",
      "binding": "NEXT_INC_CACHE_R2_BUCKET"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_UMAMI_ID": "467371a4-13c6-4342-a33b-83102ce2f85e",
    "NEXT_PUBLIC_UMAMI_DOMAINS": "smarteg.faizath.com",
    "NEXT_PUBLIC_API_HOST": "smarteg-api.faizath.com",
    "NEXT_PUBLIC_BASE_DOMAIN": "smarteg.faizath.com"
  },
  "account_id": "0c2ea70ec62e0c4f1796c8438da9a47e"
}
